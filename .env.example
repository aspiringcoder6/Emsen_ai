NODE_ENV=development

WEB_PORT=5173
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=emsen_session
SESSION_SECRET=replace_with_a_long_random_value_for_production
SESSION_TTL_HOURS=24
SESSION_REMEMBER_DAYS=30

POSTGRES_DB=creatorflow
POSTGRES_USER=creatorflow
POSTGRES_PASSWORD=creatorflow_local
DATABASE_URL=postgresql://creatorflow:creatorflow_local@localhost:5433/creatorflow

# Google Gemini — chỉ cấu hình ở backend, không dùng tiền tố VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=45000
# Production: a stable random 32-byte key encoded as base64, stored outside the database.
# Local development generates a secret in .local/ai-key-encryption.key automatically.
AI_KEY_ENCRYPTION_KEY=

REDIS_URL=redis://localhost:6379
MEDIA_QUEUE_NAME=media-processing

MINIO_ROOT_USER=creatorflow
MINIO_ROOT_PASSWORD=creatorflow_local_secret
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=creatorflow-media
