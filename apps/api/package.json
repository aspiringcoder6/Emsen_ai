{
  "name": "@creator-flow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:direction": "node --import tsx --test test/direction.test.ts",
    "test:content-plan": "node --import tsx --test test/contentPlan.test.ts",
    "test:scripts": "node --import tsx --test test/script.test.ts"
  },
  "dependencies": {
    "@creator-flow/ai-provider": "*",
    "@creator-flow/contracts": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
